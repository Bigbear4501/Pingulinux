#!/bin/bash
# 0100-customize-grub-text.hook.binary
#
# Läuft NACH dem Chroot-Aufbau, NICHT chrooted, Arbeitsverzeichnis = binary/
# 1) Ersetzt Bootmenü-Text (nur "Pingulinux OS", keine Debian/live-build/
#    Datum-Details, keine Versionsangabe mehr)
# 2) Ersetzt die Splash-Grafik (Bauhelm) durch unser eigenes Logo
# 3) Entfernt unnötige Menüeinträge (Fail-safe, Installer, Utilities)

set -e

echo "Passe Bootmenü-Text an..."

find . -iname "grub.cfg" -o -iname "*.cfg" 2>/dev/null | while read -r cfgfile; do
    echo "Bearbeite: $cfgfile"
    sed -i \
        -e 's/Debian GNU\/Linux [0-9.]* (bookworm) amd64/Pingulinux OS/g' \
        -e 's/Debian GNU\/Linux/Pingulinux OS/g' \
        -e '/^Built:/d' \
        -e '/^linux:/d' \
        -e '/^live-build:/d' \
        -e '/^live-boot:/d' \
        -e '/^live-config:/d' \
        -e '/^live-tools:/d' \
        -e 's/Press ENTER to boot or TAB to edit a menu entry/ENTER druecken zum Starten, TAB zum Bearbeiten/g' \
        -e "s/The highlighted entry will be executed automatically in %ds\\./Der markierte Eintrag startet automatisch in %d Sekunden./g" \
        -e 's/Use the \^ and v keys to select which entry is highlighted\./Waehle mit den Pfeiltasten einen Eintrag aus./g' \
        -e 's/Booting a command list/Startet eine Befehlsliste/g' \
        "$cfgfile"
done

echo "Ersetze Splash-Grafik..."

SPLASH_B64=""
echo "$SPLASH_B64" | base64 -d > /tmp/pingulinux-splash.png

find . -iname "splash.png" -o -iname "splash.svg" 2>/dev/null | while read -r splashfile; do
    echo "Ersetze: $splashfile"
    if command -v convert &> /dev/null; then
        dims=$(identify -format "%wx%h" "$splashfile" 2>/dev/null || echo "")
        if [ -n "$dims" ] && [[ "$splashfile" == *.png ]]; then
            convert /tmp/pingulinux-splash.png -resize "${dims}!" "$splashfile"
        else
            cp /tmp/pingulinux-splash.png "$splashfile"
        fi
    else
        echo "WARNUNG: 'convert' (ImageMagick) nicht gefunden auf dem Bau-System." >&2
        echo "Installiere es mit: sudo apt install imagemagick" >&2
        cp /tmp/pingulinux-splash.png "$splashfile" 2>/dev/null || true
    fi
done

echo "Entferne unerwuenschte Menueintraege..."

find . -iname "grub.cfg" -type f 2>/dev/null | while read -r cfgfile; do
    python3 << PYEOF
import re

path = "$cfgfile"
with open(path, "r") as f:
    content = f.read()

titles_to_remove = [
    "Start installer",
    "Start installer with speech synthesis",
    "Advanced install options",
    "Advanced install options...",
    "Utilities",
    "Utilities...",
]

def remove_block(text, title):
    pattern = re.compile(
        r'(menuentry|submenu)\s+["\']' + re.escape(title) + r'["\'][^\n]*\{',
    )
    m = pattern.search(text)
    if not m:
        return text
    start = m.start()
    brace_pos = text.index("{", m.start())
    depth = 1
    i = brace_pos + 1
    while depth > 0 and i < len(text):
        if text[i] == "{":
            depth += 1
        elif text[i] == "}":
            depth -= 1
        i += 1
    return text[:start] + text[i:]

for t in titles_to_remove:
    content = remove_block(content, t)

with open(path, "w") as f:
    f.write(content)
PYEOF
done

echo "Bootmenü-Anpassung abgeschlossen."

# --- "Live system (amd64)" umbenennen zu "Pingulinux OS starten" ---

echo "Benenne Boot-Eintrag um..."

find . -iname "grub.cfg" -o -iname "*.cfg" 2>/dev/null | while read -r cfgfile; do
    if grep -q "Live system" "$cfgfile" 2>/dev/null; then
        sed -i \
            -e 's/Live system (amd64 fail-safe mode)/Pingulinux OS starten (abgesicherter Modus)/g' \
            -e 's/Live system (amd64)/Pingulinux OS starten/g' \
            -e 's/Live system/Pingulinux OS starten/g' \
            "$cfgfile"
    fi
done

# --- Isolinux-Textmenüs (BIOS-Boot) ebenfalls bereinigen ---
#
# GNOME Boxes und andere VMs booten oft per Legacy-BIOS statt UEFI.
# Dabei wird NICHT grub.cfg verwendet, sondern isolinux mit separaten
# Textdateien (live.cfg, menu.cfg, stdmenu.cfg etc.). Diese enthalten
# einfache "LABEL"-Blöcke statt GRUB-Syntax, daher eigene Entfernungslogik.

find . -path "*isolinux*" -iname "*.cfg" -type f 2>/dev/null | while read -r cfgfile; do
    echo "Bereinige isolinux-Menü: $cfgfile"
    python3 << PYEOF
import re

path = "$cfgfile"
with open(path, "r") as f:
    content = f.read()

# isolinux nutzt "LABEL name" ... bis zur nächsten LABEL-Zeile oder Dateiende
labels_to_remove = [
    "install",
    "install-speech",
    "utilities",
    "advanced",
    "rescue",
]

lines = content.split("\n")
output = []
skip = False
for line in lines:
    stripped = line.strip().lower()
    if stripped.startswith("label "):
        label_name = stripped.split(None, 1)[1] if len(stripped.split(None, 1)) > 1 else ""
        skip = any(l in label_name for l in labels_to_remove)
    if not skip:
        output.append(line)

content = "\n".join(output)

# Zusätzlich: "menu begin <name> ... menu end"-Untermenü-Blöcke entfernen
# (andere Syntax als einfache LABEL-Blöcke, z.B. für das Utilities-Untermenü)
submenus_to_remove = ["utilities", "advanced"]
lines2 = content.split("\n")
output2 = []
skip_block = False
for line in lines2:
    stripped = line.strip().lower()
    if stripped.startswith("menu begin"):
        parts = stripped.split(None, 2)
        submenu_name = parts[2] if len(parts) > 2 else (parts[1] if len(parts) > 1 else "")
        if any(s in stripped for s in submenus_to_remove):
            skip_block = True
            continue
    if skip_block:
        if stripped.startswith("menu end"):
            skip_block = False
        continue
    output2.append(line)

output = output2

with open(path, "w") as f:
    f.write("\n".join(output))
PYEOF
done

echo "Isolinux-Menü-Bereinigung abgeschlossen."

# --- Zusätzlich: grub.cfg innerhalb eines eingebetteten EFI-Images patchen ---
#
# Bei UEFI-Boot wird oft eine SEPARATE Kopie der grub.cfg verwendet, die in
# einem eingebetteten FAT-Dateisystem-Image (z.B. efi.img/efiboot.img)
# liegt. Normales "find" sieht diese Datei nicht, da sie innerhalb des
# Image-Containers liegt. Wir nutzen mtools, um dort reinzuschauen.

if command -v mcopy &> /dev/null && command -v mdel &> /dev/null; then
    find . -iname "efi.img" -o -iname "efiboot.img" 2>/dev/null | while read -r imgfile; do
        echo "Untersuche EFI-Image: $imgfile"
        for path in "::EFI/boot/grub.cfg" "::efi/boot/grub.cfg" "::boot/grub/grub.cfg" "::EFI/BOOT/grub.cfg"; do
            if mcopy -i "$imgfile" -n "$path" /tmp/efi-grub.cfg 2>/dev/null; then
                echo "Gefunden und extrahiert: $path"
                sed -i \
                    -e 's/Debian GNU\/Linux [0-9.]* (bookworm) amd64/Pingulinux OS/g' \
                    -e 's/Debian GNU\/Linux/Pingulinux OS/g' \
                    -e 's/Live system (amd64 fail-safe mode)/Pingulinux OS starten (abgesicherter Modus)/g' \
                    -e 's/Live system (amd64)/Pingulinux OS starten/g' \
                    -e 's/Live system/Pingulinux OS starten/g' \
                    -e '/^Built:/d' \
                    -e '/^linux:/d' \
                    -e '/^live-build:/d' \
                    -e '/^live-boot:/d' \
                    -e '/^live-config:/d' \
                    -e '/^live-tools:/d' \
                    -e 's/Press ENTER to boot or TAB to edit a menu entry/ENTER druecken zum Starten, TAB zum Bearbeiten/g' \
                    -e "s/The highlighted entry will be executed automatically in %ds\\./Der markierte Eintrag startet automatisch in %d Sekunden./g" \
                    -e 's/Use the \^ and v keys to select which entry is highlighted\./Waehle mit den Pfeiltasten einen Eintrag aus./g' \
                    -e 's/Booting a command list/Startet eine Befehlsliste/g' \
                    /tmp/efi-grub.cfg

                python3 << PYEOF
import re

path = "/tmp/efi-grub.cfg"
with open(path, "r") as f:
    content = f.read()

titles_to_remove = [
    "Start installer",
    "Start installer with speech synthesis",
    "Advanced install options",
    "Advanced install options...",
    "Utilities",
    "Utilities...",
]

def remove_block(text, title):
    pattern = re.compile(
        r'(menuentry|submenu)\s+["\']' + re.escape(title) + r'["\'][^\n]*\{',
    )
    m = pattern.search(text)
    if not m:
        return text
    start = m.start()
    brace_pos = text.index("{", m.start())
    depth = 1
    i = brace_pos + 1
    while depth > 0 and i < len(text):
        if text[i] == "{":
            depth += 1
        elif text[i] == "}":
            depth -= 1
        i += 1
    return text[:start] + text[i:]

for t in titles_to_remove:
    content = remove_block(content, t)

with open(path, "w") as f:
    f.write(content)
PYEOF

                mdel -i "$imgfile" "$path" 2>/dev/null || true
                mcopy -i "$imgfile" /tmp/efi-grub.cfg "$path" 2>/dev/null && echo "Zurückgeschrieben: $path"
            fi
        done
    done
else
    echo "WARNUNG: mtools (mcopy/mdel) nicht gefunden auf dem Bau-System." >&2
    echo "Installiere es mit: sudo apt install mtools" >&2
    echo "Ohne mtools kann die grub.cfg im EFI-Image nicht angepasst werden." >&2
fi

# --- Bootmenü-Timeout auf 5 Sekunden setzen ---
#
# Nach 5 Sekunden ohne Nutzereingabe startet automatisch der erste
# (Standard-)Eintrag, also "Live system".

echo "Setze Bootmenü-Timeout auf 5 Sekunden..."

find . -iname "grub.cfg" -type f 2>/dev/null | while read -r cfgfile; do
    sed -i \
        -e 's/^set timeout=.*/set timeout=5/' \
        -e 's/^\(\s*\)timeout=.*/\1timeout=5/' \
        "$cfgfile"
    # Falls gar keine timeout-Zeile existiert, eine hinzufügen
    if ! grep -q "^set timeout=" "$cfgfile"; then
        sed -i '1i set timeout=5' "$cfgfile"
    fi
done

# isolinux/syslinux nutzt "timeout N" (klein geschrieben) in Zehntelsekunden (50 = 5 Sekunden)
find . -iname "*.cfg" -path "*isolinux*" -type f 2>/dev/null | while read -r cfgfile; do
    sed -i \
        -e 's/^TIMEOUT .*/TIMEOUT 50/' \
        -e 's/^timeout .*/timeout 50/' \
        -e 's/^TOTALTIMEOUT .*/TOTALTIMEOUT 50/' \
        "$cfgfile"
done

# Auch im EFI-Image die Timeout-Zeile setzen, falls dort eine grub.cfg
# gepatcht wurde (nutzt dieselbe Extraktions-Logik wie oben)
if command -v mcopy &> /dev/null && command -v mdel &> /dev/null; then
    find . -iname "efi.img" -o -iname "efiboot.img" 2>/dev/null | while read -r imgfile; do
        for path in "::EFI/boot/grub.cfg" "::efi/boot/grub.cfg" "::boot/grub/grub.cfg" "::EFI/BOOT/grub.cfg"; do
            if mcopy -i "$imgfile" -n "$path" /tmp/efi-grub-timeout.cfg 2>/dev/null; then
                sed -i \
                    -e 's/^set timeout=.*/set timeout=5/' \
                    /tmp/efi-grub-timeout.cfg
                if ! grep -q "^set timeout=" /tmp/efi-grub-timeout.cfg; then
                    sed -i '1i set timeout=5' /tmp/efi-grub-timeout.cfg
                fi
                mdel -i "$imgfile" "$path" 2>/dev/null || true
                mcopy -i "$imgfile" /tmp/efi-grub-timeout.cfg "$path" 2>/dev/null && echo "Timeout gesetzt in: $path"
            fi
        done
    done
fi

echo "Timeout-Anpassung abgeschlossen."
