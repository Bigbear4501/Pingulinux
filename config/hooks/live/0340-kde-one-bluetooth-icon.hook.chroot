#!/bin/bash
# 0340-kde-one-bluetooth-icon.hook.chroot
# Läuft chrooted, NACH der Paketinstallation.
# In KDE erschienen zwei Bluetooth-Symbole in der Taskleiste: das von KDE
# (bluedevil) und das von blueman (für XFCE). blueman startet deshalb in
# KDE nicht mehr. In XFCE bleibt blueman wie bisher.
set -e
for f in /etc/xdg/autostart/blueman*.desktop; do
    [ -f "$f" ] || continue
    if grep -q '^NotShowIn=' "$f"; then
        grep -q '^NotShowIn=.*KDE' "$f" || sed -i 's/^NotShowIn=\(.*\)$/NotShowIn=\1KDE;/' "$f"
    elif grep -q '^OnlyShowIn=' "$f"; then
        sed -i 's/^OnlyShowIn=\(.*\)KDE;\?\(.*\)$/OnlyShowIn=\1\2/' "$f"
    else
        sed -i '/^\[Desktop Entry\]/a NotShowIn=KDE;' "$f"
    fi
    echo "blueman startet in KDE nicht mehr: $f"
done
