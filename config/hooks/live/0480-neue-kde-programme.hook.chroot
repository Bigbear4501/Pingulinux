#!/bin/sh
# 0480-neue-kde-programme.hook.chroot
# Neue Programme (Wunsch Mike, 8. Nov):
#   crow-translate  Übersetzer
#   marknote        Notizen (KDE; KNotes gibt es in Debian 13 nicht mehr)
#   skanpage        Scanner (KDE, ersetzt „Dokument-Scanner“ simple-scan)
#   kamoso          Kamera-App (KDE)
#   print-manager   Drucker (KDE, ersetzt system-config-printer)
#   plasma-firewall Firewall (KDE, ersetzt Gufw; ufw bleibt als Unterbau)
#   ktuberling klettres kbruch   KDE-Lernspiele (Blinken, KHangMan, Kanagram: 10. Nov wieder raus)
# Jedes Paket einzeln: Fehlt eines in Debian 13, bricht der Bau NICHT ab,
# im Bau-Log steht dann „NEU: … fehlt“.
export DEBIAN_FRONTEND=noninteractive
for p in ufw plasma-firewall crow-translate marknote skanpage kamoso print-manager ktuberling klettres kbruch; do
    if apt-get install -y "$p" >/dev/null 2>&1; then
        echo "NEU: $p installiert"
    else
        echo "NEU: $p fehlt (nicht installierbar)" >&2
    fi
done
# LibreOffice an KDE anbinden (KDE-Aussehen und KDE-Dateidialoge).
# Paketname je nach Debian-Stand: libreoffice-kf6, sonst libreoffice-qt6.
for p in libreoffice-kf6 libreoffice-qt6; do
    if apt-get install -y "$p" >/dev/null 2>&1; then
        echo "NEU: $p installiert (LibreOffice im KDE-Stil)"; break
    fi
    echo "NEU: $p fehlt" >&2
done
# gtk3-Anbindung nicht mehr nötig, falls sie mitgekommen ist
dpkg -s libreoffice-gtk3 >/dev/null 2>&1 && dpkg -s libreoffice-kf6 >/dev/null 2>&1 && \
    apt-get purge -y libreoffice-gtk3 >/dev/null 2>&1 && echo "NEU: libreoffice-gtk3 entfernt"
exit 0
