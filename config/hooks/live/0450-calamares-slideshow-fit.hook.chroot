#!/bin/sh
# 0450-calamares-slideshow-fit.hook.chroot  (Bug b17)
#
# Die Diashow im Installer zeigte das Willkommensbild mit „Crop“: Auf
# breiten, flachen Fenstern (z. B. Surface) wurde oben und unten
# abgeschnitten, also auch die Überschrift „Willkommen bei Pingulinux!“.
# 2. Versuch (11. Nov): Beim 1. Versuch (Fit + weißes Rechteck + Ausrichtung)
# blieb die Diashow am Surface leer. Jetzt genau das funktionierende
# Original aus 0110 – nur „Crop“ durch „Fit“ ersetzt: Das ganze Bild ist zu
# sehen, nichts wird abgeschnitten, frei bleibender Platz ist Hintergrund.
# Ersetzt nur show.qml aus 0110, das Bild selbst bleibt.

D=/etc/calamares/branding/pingulinux
[ -d "$D" ] || { echo "Calamares-Branding nicht gefunden, überspringe." >&2; exit 0; }

cat > "$D/show.qml" <<'QMLEOF'
import QtQuick 2.0
import calamares.slideshow 1.0

Presentation {
    id: presentation

    Slide {
        Image {
            id: background
            source: "welcome.png"
            anchors.fill: parent
            fillMode: Image.PreserveAspectFit
            clip: true
        }
    }

    function nextSlide() {
        presentation.goToNextSlide();
    }

    Timer {
        interval: 5000
        running: true
        repeat: true
        onTriggered: presentation.nextSlide()
    }
}
QMLEOF
echo "Calamares-Diashow: Willkommensbild wird ganz gezeigt (Fit)."
exit 0
