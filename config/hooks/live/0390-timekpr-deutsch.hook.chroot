#!/bin/sh
# Timekpr-nExT auf Deutsch.
# Das Debian-Paket bringt je nach Version keine deutsche Übersetzung mit.
# Pingulinux liefert sie mit (aus Timekpr-nExT 0.5.9, Lizenz GPL-3) und
# legt sie nur ab, wenn das Paket selbst keine hat.
set -e
SRC=/usr/share/pingulinux/locale/timekpr-de.mo
DST=/usr/share/locale/de/LC_MESSAGES/timekpr.mo
if [ -f "$DST" ]; then
    echo "Timekpr: deutsche Übersetzung ist schon im Paket"
elif [ -f "$SRC" ]; then
    mkdir -p "$(dirname "$DST")"
    cp "$SRC" "$DST"
    echo "Timekpr: deutsche Übersetzung ergänzt"
fi
