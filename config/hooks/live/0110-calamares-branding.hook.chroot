#!/bin/bash
# 0110-calamares-branding.hook.chroot
#
# Läuft chrooted, NACH der Paketinstallation (Calamares muss also schon
# installiert sein, damit /etc/calamares/ existiert).
# Baut ein eigenes Pingulinux-Branding-Theme für Calamares und aktiviert es.

set -e

if [ ! -d /etc/calamares ]; then
    echo "Calamares scheint nicht installiert zu sein, überspringe Branding." >&2
    exit 0
fi

echo "Baue Pingulinux-Branding für Calamares..."

mkdir -p /etc/calamares/branding/pingulinux

# Logo einbetten
echo "" | base64 -d > /etc/calamares/branding/pingulinux/logo.png

# Logo einbetten
echo "" | base64 -d > /etc/calamares/branding/pingulinux/welcome.png

# Willkommensbild einbetten

# branding.desc schreiben
cat > /etc/calamares/branding/pingulinux/branding.desc << 'BRANDEOF'
---
componentName: pingulinux

welcomeStyleCalamares: false
welcomeExpandingLogo:  false

strings:
    productName:         "Pingulinux OS"
    shortProductName:    "Pingulinux"
    version:              "1.0"
    shortVersion:         "1.0"
    versionedName:        "Pingulinux OS 1.0"
    shortVersionedName:   "Pingulinux 1.0"
    bootloaderEntryName:  "Pingulinux OS"
    productUrl:           "https://example.org/pingulinux"
    supportUrl:           "https://example.org/pingulinux/support"
    knownIssuesUrl:       "https://example.org/pingulinux/issues"
    releaseNotesUrl:      "https://example.org/pingulinux/releasenotes"
    donateUrl:            "https://example.org/pingulinux/donate"

images:
    productLogo:          "logo.png"
    productIcon:           "logo.png"
    productWelcome:        "welcome.png"

slideshow: "show.qml"

style:
   sidebarBackground:         "#ffffff"
   sidebarText:               "#2b2b2b"
   sidebarTextSelect:         "#2e8b57"
   sidebarTextCurrent:        "#2b2b2b"
   sidebarBackgroundCurrent:  "#f0f0f0"
   sidebarBackgroundSelected: "#dcdcdc"
BRANDEOF

# Slideshow mit Willkommensbild + eigenem Begrüßungstext
cat > /etc/calamares/branding/pingulinux/show.qml << 'QMLEOF'
import QtQuick 2.0
import calamares.slideshow 1.0

Presentation {
    id: presentation

    Slide {
        Image {
            id: background
            source: "welcome.png"
            anchors.fill: parent
            fillMode: Image.PreserveAspectCrop
            clip: true
        }
    }

    function nextSlide() {
        presentation.goToNextSlide();
    }

    Timer {
        interval: 5000
        running: true
        repeat: true
        onTriggered: presentation.nextSlide()
    }
}
QMLEOF

# Aktivieren: settings.conf auf unser Branding umstellen
if [ -f /etc/calamares/settings.conf ]; then
    sed -i 's/^branding:.*/branding: pingulinux/' /etc/calamares/settings.conf
    echo "Branding in settings.conf aktiviert."
else
    echo "WARNUNG: /etc/calamares/settings.conf nicht gefunden, Branding evtl. nicht aktiv." >&2
fi

echo "Pingulinux-Calamares-Branding fertig eingerichtet."

# Das von calamares-settings-debian automatisch mitgelieferte
# Desktop-Icon entfernen, damit nur unser eigenes (mit Branding,
# passwortlosem sudo und Trust-Markierung) übrig bleibt.
rm -f /etc/skel/Desktop/install-debian.desktop
rm -f /usr/share/applications/calamares.desktop 2>/dev/null || true
echo "Automatisches Debian-Installer-Icon entfernt."
