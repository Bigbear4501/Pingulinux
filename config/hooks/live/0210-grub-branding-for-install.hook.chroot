#!/bin/bash
# 0210-grub-branding-for-install.hook.chroot
#
# Setzt /etc/default/grub mit Pingulinux-Branding. Diese Datei landet
# über das Live-Dateisystem (squashfs) automatisch auch auf dem
# installierten System (Calamares kopiert das gesamte Live-Root über
# "unpackfs"). Wenn Calamares danach sein "bootloader"/"grubcfg"-Modul
# ausführt (update-grub auf dem Zielsystem), nutzt es GENAU diese
# Einstellungen - dadurch bekommt auch das installierte System unser
# Branding im GRUB-Menü, nicht nur das Live-Boot-Medium.

set -e

GRUB_DEFAULT="/etc/default/grub"

if [ ! -f "$GRUB_DEFAULT" ]; then
    echo "/etc/default/grub nicht gefunden, überspringe." >&2
    exit 0
fi

cp "$GRUB_DEFAULT" "$GRUB_DEFAULT.orig"

# GRUB_DISTRIBUTOR ersetzt "Debian GNU/Linux" durch unseren Namen in
# den automatisch generierten Menüeinträgen (z.B. "Pingulinux OS" statt
# "Debian GNU/Linux, mit Linux 6.12...")
if grep -q "^GRUB_DISTRIBUTOR=" "$GRUB_DEFAULT"; then
    sed -i 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR="Pingulinux OS"/' "$GRUB_DEFAULT"
else
    echo 'GRUB_DISTRIBUTOR="Pingulinux OS"' >> "$GRUB_DEFAULT"
fi

# 5-Sekunden-Timeout, wie im Live-Medium
if grep -q "^GRUB_TIMEOUT=" "$GRUB_DEFAULT"; then
    sed -i 's/^GRUB_TIMEOUT=.*/GRUB_TIMEOUT=5/' "$GRUB_DEFAULT"
else
    echo 'GRUB_TIMEOUT=5' >> "$GRUB_DEFAULT"
fi

echo 'GRUB_TIMEOUT_STYLE=menu' >> "$GRUB_DEFAULT"

# Eigenes Hintergrundbild fürs installierte GRUB-Menü (Datei muss
# dauerhaft im System liegen, damit update-grub sie später findet)
if [ -f /usr/share/plymouth/themes/pingulinux/logo.png ]; then
    mkdir -p /usr/share/pingulinux
    cp /usr/share/plymouth/themes/pingulinux/logo.png /usr/share/pingulinux/grub-background.png
    echo 'GRUB_BACKGROUND="/usr/share/pingulinux/grub-background.png"' >> "$GRUB_DEFAULT"
fi

echo "GRUB-Branding für installiertes System gesetzt."
echo "Original gesichert unter $GRUB_DEFAULT.orig"
