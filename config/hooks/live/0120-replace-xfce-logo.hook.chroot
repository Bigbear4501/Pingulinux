#!/bin/bash
# 0120-replace-xfce-logo.hook.chroot
#
# Läuft chrooted, NACH der Paketinstallation.
# Ersetzt das XFCE-Logo (z.B. im "Über Xfce"-Dialog, ggf. Panel-Icon)
# systemweit durch unser Pingu-Maskottchen, in mehreren Icon-Größen.

set -e

mkdir -p /tmp/pingu-icons
echo '' | base64 -d > /tmp/pingu-icons/pingu-16.png
echo '' | base64 -d > /tmp/pingu-icons/pingu-22.png
echo '' | base64 -d > /tmp/pingu-icons/pingu-24.png
echo '' | base64 -d > /tmp/pingu-icons/pingu-32.png
echo '' | base64 -d > /tmp/pingu-icons/pingu-48.png
echo '' | base64 -d > /tmp/pingu-icons/pingu-64.png
echo '' | base64 -d > /tmp/pingu-icons/pingu-128.png
echo '' | base64 -d > /tmp/pingu-icons/pingu-256.png

echo "Suche und ersetze XFCE-Logo-Dateien..."

# Typische Dateinamen für das XFCE-Logo/About-Icon in verschiedenen Themes
PATTERNS=("xfce4-logo*.png" "org.xfce.xfce4-about*.png" "xfce4-about*.png")

for pattern in "${PATTERNS[@]}"; do
    find /usr/share/icons /usr/share/pixmaps -iname "$pattern" 2>/dev/null | while read -r iconfile; do
        # Größe aus dem Verzeichnisnamen ableiten (z.B. .../48x48/apps/...)
        dir=$(dirname "$iconfile")
        size=$(echo "$dir" | grep -oE '[0-9]+x[0-9]+' | head -1 | cut -dx -f1)

        if [ -z "$size" ]; then
            size=48
        fi

        # Nächstgelegene verfügbare Größe wählen
        closest=48
        min_diff=9999
        for s in 16 22 24 32 48 64 128 256; do
            diff=$(( s > size ? s - size : size - s ))
            if [ "$diff" -lt "$min_diff" ]; then
                min_diff=$diff
                closest=$s
            fi
        done

        if [ -f "/tmp/pingu-icons/pingu-${closest}.png" ]; then
            echo "Ersetze: $iconfile (Größe ~$size -> nutze ${closest}px Icon)"
            cp "/tmp/pingu-icons/pingu-${closest}.png" "$iconfile"
        fi
    done
done

# Icon-Cache aktualisieren, damit die Änderung sofort sichtbar wird
if command -v gtk-update-icon-cache &> /dev/null; then
    find /usr/share/icons -maxdepth 1 -mindepth 1 -type d | while read -r theme; do
        gtk-update-icon-cache -f "$theme" 2>/dev/null || true
    done
fi

echo "XFCE-Logo-Ersetzung abgeschlossen."
