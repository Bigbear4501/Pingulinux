#!/bin/sh
# 0460-supertuxkart-deutsch.hook.chroot  (Beta 1)
# SuperTuxKart folgt der Sprache aus LANGUAGE/LANG. Läuft die Sitzung nicht
# auf Deutsch (z. B. Live-Modus ohne Startparameter), startet es englisch.
# Der Starter gibt deshalb Deutsch fest mit. Englisch bleibt Ersatz,
# falls ein Text nicht übersetzt ist.
for f in /usr/share/applications/supertuxkart.desktop /usr/share/applications/*supertuxkart*.desktop; do
    [ -f "$f" ] || continue
    sed -i -E 's#^Exec=(env LANGUAGE=[^ ]+ )?supertuxkart#Exec=env LANGUAGE=de_DE:de:en supertuxkart#' "$f"
    grep -m1 '^Exec=' "$f"
done
PO=$(ls /usr/share/games/supertuxkart/data/po/de*.po 2>/dev/null | head -1)
[ -n "$PO" ] && echo "SuperTuxKart: deutsche Übersetzung vorhanden ($PO)" || echo "WARNUNG: keine deutsche SuperTuxKart-Übersetzung gefunden" >&2
exit 0
