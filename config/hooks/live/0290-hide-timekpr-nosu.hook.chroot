#!/bin/sh
# 0290: Timekpr-Einträge im Startmenü ausblenden (alle, auch der SU-Modus).
# Die Bildschirmzeit stellen Eltern im Kontrollzentrum ein
# (pingulinux-bildschirmzeit.py). Timekpr-nExT bleibt der Unterbau; die
# Timekpr-Oberfläche gibt es dort über „Timekpr öffnen“.
# Das Kinder-Symbol (Restzeit in der Taskleiste) bleibt unverändert.
for p in /usr/share/applications/timekpr*.desktop; do
  [ -f "$p" ] || continue
  case "$(basename "$p")" in *client*) continue ;; esac
  grep -q '^NoDisplay=' "$p" && sed -i 's/^NoDisplay=.*/NoDisplay=true/' "$p" || sed -i '/^\[Desktop Entry\]/a NoDisplay=true' "$p"
done
exit 0
