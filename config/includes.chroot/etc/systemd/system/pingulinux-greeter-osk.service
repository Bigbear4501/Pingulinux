[Unit]
Description=Pingulinux: Bildschirmtastatur im Anmeldebildschirm auf Touch-Geräten
After=systemd-udevd.service systemd-udev-trigger.service
Before=display-manager.service lightdm.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/pingulinux-greeter-osk.sh

[Install]
WantedBy=multi-user.target
